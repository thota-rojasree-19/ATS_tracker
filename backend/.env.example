# Django Settings
DEBUG=True
SECRET_KEY=replace-with-a-local-development-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (falls back to SQLite when DATABASE_URL is unset)
DATABASE_URL=postgresql://postgres:password@localhost:5432/earlyjobs_ats

# Company Email Domain Restriction
ALLOWED_EMAIL_DOMAIN=earlyjobs.in

# JWT & Auth Cookie Configuration
JWT_SECRET_KEY=replace-with-a-strong-jwt-signing-secret
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax

# OTP Verification Policy
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5

# Email / SMTP Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-smtp-username@earlyjobs.in
EMAIL_HOST_PASSWORD=replace-with-smtp-password
DEFAULT_FROM_EMAIL=EarlyJobs.ai ATS <no-reply@earlyjobs.in>

# Frontend URL (used in invitation/notification emails)
FRONTEND_URL=http://localhost:5173

# Optional: allow all CORS in dev (not recommended for production)
# CORS_ALLOW_ALL_ORIGINS=False

